// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Instance {
  status   String
  path     Path   @relation(fields: [pathName], references: [name])
  pathName String @id
}

model Path {
  name     String     @id
  created  DateTime   @default(now())
  record   Record[]
  instance Instance?
}

model RecordSourceMetadata {
  recordId     String   @id
  record          Record[]
  title        String
  uploader     String
  dateUploaded DateTime
  webpageUrl   String
  description  String
}

model Record {
  id               String                @id
  path             Path                  @relation(fields: [pathName], references: [name])
  pathName         String
  sourceMetadata   RecordSourceMetadata? @relation(fields: [sourceMetadataId], references: [recordId], onDelete: SetNull, onUpdate: Cascade)
  sourceMetadataId String?
  manifestPath     String
  datePublished    DateTime @map("publishedDate")

  @@map("RecordProps")
}
