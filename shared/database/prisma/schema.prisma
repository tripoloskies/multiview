// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Instance {
  status      String
  path        Path     @relation(fields: [pathName], references: [name])
  pathName    String   @id
  lowLatency  Boolean  @default(false)
  dateCreated DateTime @default(now())
  record      Record?
}

model Path {
  name        String    @id
  platform    String
  dateCreated DateTime  @default(now())
  record      Record[]
  instance    Instance?
}

model RecordSourceMetadata {
  id           String   @id
  record       Record[]
  sourceId     String?
  uploaderId   String
  title        String
  uploader     String
  dateUploaded DateTime
  webpageUrl   String
  description  String
}

model Record {
  id               String                @id
  path             Path                  @relation(fields: [pathName], references: [name])
  pathName         String
  instanceId       String?               @unique
  instance         Instance?             @relation(fields: [instanceId], references: [pathName], onDelete: SetNull, onUpdate: Cascade)
  sourceMetadata   RecordSourceMetadata? @relation(fields: [sourceMetadataId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceMetadataId String?
  manifestPath     String
  datePublished    DateTime              @default(now())
}
